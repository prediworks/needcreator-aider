{
  "manifest_version": 3,
  "name": "Prospecting Assistant",
  "description": "Reads the pages a task queue asks for, in your own browser session, and sends the visible text and links back to your server. Never likes, follows, comments or sends messages.",
  "version": "0.1.0",
  "default_locale": "en",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "*://*.youtube.com/*",
    "*://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prospecting Assistant"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
