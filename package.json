{
  "name": "ugc-platform",
  "version": "1.0.0",
  "description": "UGC Platform - Full Stack Application",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "test": "npm test --prefix backend && npm test --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "deploy:preprod": "npm run deploy:preprod --prefix backend",
    "deploy:prod": "npm run deploy:prod --prefix backend"
  },
  "keywords": [
    "ugc",
    "platform",
    "content-creation"
  ],
  "author": "UGC Platform Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
