# API backend (port 3002) — depuis un autre poste : http://<ip-du-serveur>:3002/api
NEXT_PUBLIC_API_URL=http://localhost:3002/api

# Adresse publique du site (SEO : URL canoniques, sitemap, partage)
NEXT_PUBLIC_SITE_URL=https://needcreator.com

# Firebase (clés publiques : Project settings → General)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stripe (clé publique test)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cloudflare Turnstile (anti-robot sur l'inscription) : vide = désactivé
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Prix minimum d'un devis / budget, identique à MIN_QUOTE_PRICE du backend
NEXT_PUBLIC_MIN_QUOTE_PRICE=50

# Monitoring des erreurs (facultatif) : projet Next.js sur sentry.io ou GlitchTip
NEXT_PUBLIC_SENTRY_DSN=
