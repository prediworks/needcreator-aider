{
  "name": "ugc-platform-backend",
  "version": "1.0.0",
  "description": "Backend API for UGC Platform - Deployment agnostic",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node scripts/e2e-test.js --clean",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:auth": "NODE_ENV=test jest src/tests/auth.test.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "check:env": "node scripts/check-env.js",
    "check:connect": "node scripts/check-connect.js",
    "r2:cors": "node scripts/r2-cors.js",
    "make-admin": "node scripts/make-admin.js",
    "test:e2e": "node scripts/e2e-test.js",
    "test:unit": "NODE_ENV=test jest --coverage --detectOpenHandles"
  },
  "keywords": [
    "ugc",
    "platform",
    "api",
    "mongodb"
  ],
  "author": "UGC Platform Team",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/groq": "^4.0.37",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@aws-sdk/client-s3": "^3.478.0",
    "@aws-sdk/s3-request-presigner": "^3.478.0",
    "ai": "^7.0.93",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "sharp": "^0.33.1",
    "stripe": "^14.10.0",
    "winston": "^3.11.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^20.10.6",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
