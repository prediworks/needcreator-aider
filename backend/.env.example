# Environment
NODE_ENV=development
PORT=3002

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ugc-platform?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb://localhost:27017/ugc-platform-test

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PERCENT=10

# Storage (Cloudflare R2)
STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_BUCKET_NAME=ugc-platform
CLOUDFLARE_PUBLIC_URL=https://your-bucket.r2.dev

# Email (SMTP)
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
FROM_EMAIL=noreply@ton-domaine.com

# SendGrid fallback (optional)
SENDGRID_API_KEY=SG.xxx

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3003

# Tests uniquement : confirme les paiements avec une carte de test sans écran de saisie (ignoré en production)
STRIPE_AUTO_CONFIRM_TEST=false

# Brief assisté par IA (prompts dans config/prompts/)
AI_PROVIDER=anthropic          # anthropic | openai
AI_MODEL=claude-opus-5         # ou gpt-5 pour openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Parrainage
REFERRAL_BRAND_FEE_PERCENT=5
REFERRAL_REFERRER_FEE_PERCENT=5
REFERRAL_CREATOR_BONUS=10

# Badges / avant-première
EARLY_ACCESS_HOURS=24

# Pack vidéo prête à diffuser (€ par vidéo, 0 = inclus). Sous-titres automatiques si OPENAI_API_KEY est renseignée.
READY_PACK_PRICE=15
AI_TRANSCRIPTION_MODEL=whisper-1
