# Environment
NODE_ENV=development
PORT=3002

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ugc-platform?retryWrites=true&w=majority

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PERCENT=10

# Storage (Cloudflare R2)
STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_BUCKET_NAME=ugc-platform
CLOUDFLARE_PUBLIC_URL=https://<account-id>.r2.cloudflarestorage.com/<bucket>   # en prod : domaine public du bucket (liens permanents)

# Email (SMTP)
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
FROM_EMAIL=noreply@ton-domaine.com

# SendGrid : repli optionnel, utilisé seulement si SMTP_HOST est absent
SENDGRID_API_KEY=

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000   # 300 en production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000,http://95.111.238.135:3000   # plusieurs origines possibles, séparées par des virgules

# Tests uniquement : confirme les paiements avec une carte de test sans écran de saisie (ignoré en production)
STRIPE_AUTO_CONFIRM_TEST=false

# Brief assisté par IA (prompts dans config/prompts/)
AI_PROVIDER=anthropic          # anthropic | openai | groq | novita | together | openrouter | mistral | ollama | openai-compatible
AI_MODEL=claude-opus-5         # ex. gpt-5, llama-3.3-70b-versatile (groq), meta-llama/llama-3.1-70b-instruct (novita)
AI_API_KEY=                    # clé générique (sinon les clés spécifiques ci-dessous)
AI_BASE_URL=                   # uniquement pour openai-compatible (ou pour remplacer l'URL par défaut)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Parrainage
REFERRAL_BRAND_DISCOUNT_PERCENT=5      # réduction (% du devis) pour la marque parrainée sur sa 1re campagne
REFERRAL_REFERRER_DISCOUNT_PERCENT=5   # réduction pour la marque marraine sur sa campagne suivante
REFERRAL_CREATOR_BONUS=10

# Badges / avant-première
EARLY_ACCESS_HOURS=24
BADGE_CONFIRMED_JOBS=3
BADGE_CONFIRMED_RATING=4.5
BADGE_EXPERT_JOBS=10
BADGE_EXPERT_RATING=4.7

# Règles métier
MIN_CREATOR_VIDEOS=3
REPLACEMENT_GRACE_HOURS=48   # garantie de remplacement : délai après la date de livraison prévue
MIN_QUOTE_PRICE=50           # prix minimum d'un devis et d'un budget (€) ; côté frontend : NEXT_PUBLIC_MIN_QUOTE_PRICE

# Monitoring
SENTRY_DSN=                  # vide = désactivé. Créer un projet Node.js sur sentry.io (gratuit) ou GlitchTip
SENTRY_TRACES_RATE=0.05
ADMIN_ALERT_EMAIL=           # destinataires des alertes admin (virements en échec, signalements, récapitulatif quotidien) ; vide = tous les comptes admin

# Outil temporaire : bouton admin « Purger les campagnes et missions » d'un compte (validation de la prod). false = bouton inactif
ADMIN_PURGE_ENABLED=false
JOBS_INTERVAL_MINUTES=60

# Pack vidéo prête à diffuser (€ par vidéo, 0 = inclus)
READY_PACK_PRICE=15

# Transcription des vidéos (sous-titres du pack, contrôle « mention du produit » du score de conformité).
# Paramétrage indépendant du brief IA. Sans clé, ces deux fonctions sont simplement désactivées.
TRANSCRIPTION_PROVIDER=groq          # groq | openai | mistral | openai-compatible (déduit des clés présentes si vide)
TRANSCRIPTION_API_KEY=               # repli : GROQ_API_KEY / OPENAI_API_KEY / MISTRAL_API_KEY selon le fournisseur
TRANSCRIPTION_MODEL=                 # repli : whisper-large-v3 (groq), whisper-1 (openai), voxtral-mini-latest (mistral)
TRANSCRIPTION_BASE_URL=              # uniquement pour openai-compatible

# Intégration Shopify (application créée sur partners.shopify.com ; URL de callback : SHOPIFY_APP_URL/api/integrations/shopify/callback)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products
SHOPIFY_APP_URL=https://api.votre-domaine.fr

# Abonnement Pro (marques) et quotas
PRO_PRICE_EUR=79
PRO_TRIAL_DAYS=14
PRO_FEE_PERCENT=10   # identique au taux standard (Pro ne réduit plus la commission)
STRIPE_PRO_PRICE_ID=            # facultatif : sinon créé automatiquement (lookup_key needcreator_pro_monthly)
AI_BRIEF_FREE_QUOTA=3

# Limites progressives des nouvelles marques (aucune campagne terminée)
LIMIT_NEW_BRAND_OPEN_CAMPAIGNS=2
LIMIT_NEW_BRAND_INVITES_PER_DAY=5
LIMIT_NEW_BRAND_MESSAGES_PER_DAY=20

# Gifting (produit offert)
GIFTING_MIN_PRODUCT_VALUE=30
GIFTING_MAX_DELIVERABLES=2
GIFTING_MAX_PER_MONTH=2
GIFTING_FEE_PER_VIDEO=5

# Vérification des SIRET au registre national des entreprises (modifiable aussi depuis l'admin → Réglages)
BUSINESS_REGISTRY_CHECK=true

# Email confirmé obligatoire pour publier une campagne / envoyer un devis (false = désactivé)
REQUIRE_EMAIL_VERIFICATION=true

# Version des CGU / confidentialité (date). La changer redemande l'acceptation à tous les utilisateurs
LEGAL_TERMS_VERSION=2026-09-09

# Cloudflare Turnstile (anti-robot sur l'inscription) : vide = désactivé
# Clés de test : site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
